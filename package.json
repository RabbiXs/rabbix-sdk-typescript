{
  "name": "@rabbix/sdk",
  "version": "0.1.0",
  "description": "RabbiX SDK for TypeScript: govern what autonomous AI agents commit",
  "homepage": "https://github.com/RabbiXs/rabbix-sdk-typescript#readme",
  "bugs": {
    "url": "https://github.com/RabbiXs/rabbix-sdk-typescript/issues"
  },
  "license": "Apache-2.0",
  "author": "RabbiX",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RabbiXs/rabbix-sdk-typescript.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
